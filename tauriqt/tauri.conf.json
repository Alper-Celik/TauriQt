{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TauriQt",
  "version": "0.1.0",
  "identifier": "dev.tauriqt.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TauriQt",
        "width": 1024,
        "height": 768,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
